# Telegram bot username without "@" (from @BotFather), used for the t.me sign-in link.
# Not a secret; the webhook secret lives in Secret Manager (TELEGRAM_WEBHOOK_SECRET).
TELEGRAM_BOT_USERNAME=menikitopildi_bot

# Moderator chat for shikoyatlar (topildiOnReportCreated). Message the bot from
# that chat, then read the chat id from getUpdates. Empty turns sending off.
TELEGRAM_ADMIN_CHAT_ID=-5544898008

# Where app errors go (topildiLogError). Empty falls back to
# TELEGRAM_ADMIN_CHAT_ID; both empty turns error reports off.
TELEGRAM_ERRORS_CHAT_ID=-5577116667
