rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- FoodZeen (same Firebase project) — kept unchanged ----
    match /users/{userId}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- Topildi ----
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Blocking is one-way and silent: [other] has blocked the signed-in user,
    // who may then neither write to them nor claim their listings.
    function blockedBy(other) {
      return exists(/databases/$(database)/documents/topildi_users/$(other)/blocked/$(request.auth.uid));
    }

    // Telegram sign-in attempts (functions/src/login.ts): server only.
    match /topildi_tg_sessions/{sid} {
      allow read, write: if false;
    }
    match /topildi_tg_chats/{chatId} {
      allow read, write: if false;
    }

    // Public profile. No phone number is ever stored here.
    match /topildi_users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(
             ['firstName', 'avatarUrl', 'avatarEmoji', 'avatarTone', 'returnedCount',
              'showNameOnReturns', 'createdAt', 'updatedAt'])
        && (!('firstName' in request.resource.data)
            || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 30))
        // "Qaytarganlarimda ismim koʻrinsin": the only consent the app keeps.
        // topildiOnNameConsentChanged copies it onto, or off, every listing
        // this person returned (functions/src/returns.ts).
        && (!('showNameOnReturns' in request.resource.data)
            || request.resource.data.showNameOnReturns is bool);
      allow delete: if isMe(uid);

      // Push targets, id = the FCM token. Owner only: never public.
      match /devices/{token} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'lang', 'updatedAt'])
          && request.resource.data.token == token
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.lang in ['uz_Latn', 'uz_Cyrl', 'ru'];
      }

      // People this user has blocked, id = the blocked uid. The owner keeps
      // the list; the blocked person may read only their own entry, which is
      // what the chat needs to know that writing is closed.
      match /blocked/{otherUid} {
        allow read: if isMe(uid) || isMe(otherUid);
        allow create, update: if isMe(uid)
          && otherUid != uid
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && (!('name' in request.resource.data)
              || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
          && request.resource.data.createdAt == request.time;
        allow delete: if isMe(uid);
      }

      // Written by Cloud Functions (Admin SDK); the owner only marks them read.
      match /notifications/{id} {
        allow read: if isMe(uid);
        allow update: if isMe(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    // Who returned which item (functions/src/returns.ts). Server only: it is
    // what lets consent be taken back everywhere at once, and it must never
    // become a public map from a returned listing to the person who found it.
    match /topildi_returns/{listingId} {
      allow read, write: if false;
    }

    match /topildi_listings/{id} {
      function validListing(d) {
        return d.keys().hasOnly(['type', 'category', 'title', 'description', 'areaName', 'city', 'district',
                                 'lat', 'lng', 'happenedAt', 'authorId', 'authorName', 'authorReturnedCount',
                                 'photoUrls', 'tint', 'status', 'createdAt', 'updatedAt'])
          && d.type in ['found', 'lost']
          && d.category in ['documents', 'phones', 'keys', 'wallets', 'bags', 'electronics', 'clothes', 'kids', 'other']
          && d.title is string && d.title.size() >= 3 && d.title.size() <= 60
          && d.description is string && d.description.size() <= 500
          && d.areaName is string && d.areaName.size() <= 200
          && d.lat is number && d.lng is number
          && d.happenedAt is timestamp
          && d.photoUrls is list && d.photoUrls.size() <= 6;
      }

      // 'finderDisplayName' is the server's alone (functions/src/returns.ts):
      // it is absent from every key list here, so no client can write a name
      // onto a returned listing — or keep one there after consent is taken
      // back. It is only ever set while the listing is 'returned', and
      // validListing runs on create and on edits of an 'active' listing, so
      // its hasOnly never meets the field.

      // The finder closes the listing from the chat of an accepted claim;
      // for a "lost" listing that is not the author.
      function returnedViaChat() {
        let chat = get(/databases/$(database)/documents/topildi_chats/$(request.resource.data.returnedViaChat)).data;
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'returnedViaChat'])
          && resource.data.status == 'active' && request.resource.data.status == 'returned'
          && chat.finderId == request.auth.uid && chat.listingId == id;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'active'
        && validListing(request.resource.data);
      // The author may change the status (active -> returned), or edit an
      // active listing's content; type, author and dates stay as they are.
      // 'hidden' (set by topildiOnReportCreated once three people reported the
      // listing) is the server's alone: the author can neither set nor leave it.
      allow update: if (isMe(resource.data.authorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status != 'hidden'
          && request.resource.data.status in ['active', 'returned'])
        || (isMe(resource.data.authorId)
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['category', 'title', 'areaName', 'city', 'district', 'lat', 'lng', 'happenedAt',
                'photoUrls', 'tint', 'updatedAt'])
          && validListing(request.resource.data))
        || returnedViaChat();
      allow delete: if isMe(resource.data.authorId);

      // Hidden detail: the author only.
      match /private/secret {
        allow read, delete: if isMe(resource.data.authorId);
        allow create: if isMe(request.resource.data.authorId)
          && request.resource.data.keys().hasOnly(['hiddenDetail', 'authorId'])
          && request.resource.data.hiddenDetail is string
          && request.resource.data.hiddenDetail.size() <= 200;
        // Editing; the app locks it once requests came in.
        allow update: if isMe(resource.data.authorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenDetail'])
          && request.resource.data.hiddenDetail is string
          && request.resource.data.hiddenDetail.size() <= 200;
      }
    }

    // "Bu meniki": id {listingId}_{claimantUid}_{attempt}. At most three
    // attempts, and a new one only after the previous was rejected.
    match /topildi_claims/{claimId} {
      function listingOf(id) { return get(/databases/$(database)/documents/topildi_listings/$(id)).data; }
      function claimPath(listingId, n) {
        return /databases/$(database)/documents/topildi_claims/$(listingId + '_' + request.auth.uid + '_' + string(n));
      }
      function validClaim(d) {
        return d.keys().hasOnly(['listingId', 'listingAuthorId', 'claimantId', 'claimantName', 'claimantReturnedCount',
                                 'answer', 'attempt', 'proofUrl', 'status', 'createdAt'])
          && d.answer is string && d.answer.size() >= 10 && d.answer.size() <= 500
          && d.claimantName is string && d.claimantName.size() <= 40
          && (!('proofUrl' in d) || d.proofUrl is string)
          && d.attempt in [1, 2, 3]
          && d.createdAt == request.time;
      }

      allow read: if isMe(resource.data.claimantId) || isMe(resource.data.listingAuthorId);
      allow create: if signedIn()
        && validClaim(request.resource.data)
        && request.resource.data.claimantId == request.auth.uid
        && request.resource.data.status == 'pending'
        && claimId == request.resource.data.listingId + '_' + request.auth.uid + '_' + string(request.resource.data.attempt)
        && listingOf(request.resource.data.listingId).authorId == request.resource.data.listingAuthorId
        && listingOf(request.resource.data.listingId).status == 'active'
        && request.resource.data.listingAuthorId != request.auth.uid
        && !blockedBy(request.resource.data.listingAuthorId)
        && (request.resource.data.attempt == 1
            || get(claimPath(request.resource.data.listingId, request.resource.data.attempt - 1)).data.status
               in ['rejected', 'cancelled']);
      // The listing's author answers once: pending -> accepted | rejected.
      allow update: if isMe(resource.data.listingAuthorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected'];
      // The claimant may take back a claim left unanswered for 3 days
      // (ClaimTarget.cancelAfter); the attempt number is free again.
      allow delete: if isMe(resource.data.claimantId)
        && resource.data.status == 'pending'
        && request.time > resource.data.createdAt + duration.value(3, 'd');
    }

    // A chat has the id of the claim that opened it and exists only next to
    // that claim once accepted. Two members; no phone numbers.
    match /topildi_chats/{chatId} {
      function claim() { return getAfter(/databases/$(database)/documents/topildi_claims/$(chatId)).data; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // Only my own read time; unread counts of both (mine reset, theirs +1).
      function activity() {
        return changed().hasOnly(['lastMessage', 'lastAt', 'lastSenderId', 'unread', 'readAt'])
          && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid])
          && (!('lastSenderId' in changed()) || request.resource.data.lastSenderId == request.auth.uid);
      }
      function finderReturns() {
        return isMe(resource.data.finderId)
          && changed().hasOnly(['returned', 'returnedAt', 'lastMessage', 'lastAt', 'lastSenderId', 'unread'])
          && resource.data.returned == false && request.resource.data.returned == true
          && request.resource.data.lastSenderId == request.auth.uid;
      }

      allow read: if isMember();
      allow create: if signedIn()
        && claim().status == 'accepted'
        && claim().listingAuthorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['listingId', 'listingTitle', 'listingCategory', 'listingTint', 'members',
             'finderId', 'names', 'returnedCounts', 'lastMessage', 'lastAt', 'lastSenderId', 'unread', 'readAt',
             'returned', 'createdAt'])
        && request.resource.data.listingId == claim().listingId
        && request.resource.data.members == [claim().listingAuthorId, claim().claimantId]
        && request.resource.data.finderId in request.resource.data.members
        && request.resource.data.returned == false;
      allow update: if isMember() && (activity() || finderReturns());

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/topildi_chats/$(chatId)).data; }
        function other() {
          return chat().members[0] == request.auth.uid ? chat().members[1] : chat().members[0];
        }

        allow read: if signedIn() && request.auth.uid in chat().members;
        allow create: if signedIn() && request.auth.uid in chat().members
          && !blockedBy(other())
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && ((request.resource.data.kind == 'text' && chat().returned == false)
              || (request.resource.data.kind == 'returned' && chat().finderId == request.auth.uid));
      }
    }

    // Shikoyatlar. The app only ever writes one, and reads back only its own
    // (the sheet shows "already sent"); moderation happens in Cloud Functions
    // and Telegram, which go through the Admin SDK and past these rules.
    // Id {targetType}_{targetId}_{reporterUid}: one report per person per target.
    match /topildi_reports/{reportId} {
      function listingOf(id) { return get(/databases/$(database)/documents/topildi_listings/$(id)).data; }
      function chatOf(id) { return get(/databases/$(database)/documents/topildi_chats/$(id)).data; }
      function validReport(d) {
        return d.keys().hasOnly(['targetType', 'targetId', 'reportedUid', 'reporterId',
                                 'reason', 'comment', 'status', 'createdAt'])
          && d.targetType in ['listing', 'chat']
          && d.targetId is string && d.targetId.size() > 0
          && d.reportedUid is string && d.reportedUid.size() > 0
          && d.reason in ['spam', 'fake', 'scam', 'offensive', 'other']
          && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
          && d.status == 'open'
          && d.createdAt == request.time
          && d.reporterId == request.auth.uid
          && d.reportedUid != request.auth.uid
          && reportId == d.targetType + '_' + d.targetId + '_' + request.auth.uid;
      }
      // Who is reported has to follow from the target: a listing's author, or
      // the other member of a chat the reporter is in.
      function validTarget(d) {
        return (d.targetType == 'listing' && listingOf(d.targetId).authorId == d.reportedUid)
          || (d.targetType == 'chat'
              && request.auth.uid in chatOf(d.targetId).members
              && d.reportedUid in chatOf(d.targetId).members);
      }

      // `resource == null` is the sheet asking whether it reported this before.
      allow get: if signedIn() && (resource == null || isMe(resource.data.reporterId));
      allow list, delete: if false;
      allow create: if signedIn() && validReport(request.resource.data) && validTarget(request.resource.data);
      // Reporting the same target again, once the moderator has closed the
      // last one: the reporter writes the whole document anew (validReport
      // pins the id, so the target and the reporter cannot change), and the
      // server's own fields — evidence, reports, modKey — go with it. While
      // the report is open this is refused, which is what stops the spam.
      allow update: if signedIn()
        && isMe(resource.data.reporterId)
        && resource.data.status != 'open'
        && validReport(request.resource.data)
        && validTarget(request.resource.data);
    }
  }
}
