rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ---- FoodZeen (same Firebase project) — kept unchanged ----
    match /users/{userId}/recipes/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- Topildi ----
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Listing photos: each author's own folder ({name} starts with the
    // listing id). No Firestore lookup, so posting never depends on
    // cross-service rules.
    match /topildi/uploads/{uid}/{name} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && isImage();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Older listings: photos were uploaded before the listing document was written,
    // so a missing document means "being created"; afterwards only its author.
    match /topildi/listings/{id}/{file} {
      function listing() { return /databases/(default)/documents/topildi_listings/$(id); }
      function mayWrite() {
        return request.auth != null
          && (!firestore.exists(listing()) || firestore.get(listing()).data.authorId == request.auth.uid);
      }
      allow read: if request.auth != null;
      allow create, update: if mayWrite() && isImage();
      allow delete: if mayWrite();
    }

    // Proof photo of a claim ({listingId}_{uid}_{n}): uploaded by the
    // claimant before the claim exists; seen by the claimant and the author.
    match /topildi/claims/{claimId}/proof.jpg {
      function claim() { return /databases/(default)/documents/topildi_claims/$(claimId); }
      function isClaimant() {
        return request.auth != null && claimId.matches('^[A-Za-z0-9]+_' + request.auth.uid + '_[1-3]$');
      }
      allow read: if isClaimant()
        || (request.auth != null && firestore.get(claim()).data.listingAuthorId == request.auth.uid);
      allow create, update: if isClaimant() && !firestore.exists(claim()) && isImage();
      allow delete: if isClaimant() && !firestore.exists(claim());
    }

    match /topildi/users/{uid}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || isImage());
    }
  }
}
